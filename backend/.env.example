# Copy to .env in this directory (gitignored). Used by root docker-compose and backend/docker-compose.

# --- Runtime ---
NODE_ENV=development
PORT=3000
DATABASE_PATH=./data/decisions.db

# --- Storage ---
# sqlite: persistent local database (Docker / dev)
# memory: in-process storage for demo deploys (data lost on restart)
STORAGE_PROVIDER=sqlite

# --- Logging ---
LOG_LEVEL=info

# --- OpenAI ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_TIMEOUT_MS=30000
OPENAI_MAX_RETRIES=2

# --- Queue (BullMQ) ---
# Local (no Compose): redis://localhost:6379
# Under Docker Compose, REDIS_URL comes from root `.env` and overrides this.
REDIS_URL=redis://localhost:6379
# Workers set SKIP_DB_MIGRATIONS=1 in compose (API owns migrations on shared SQLite).

# --- Architecture decision generator ---
# template: local markdown generator (default, no API key required)
# openai: requires OPENAI_API_KEY
ARCHITECTURE_DECISION_GENERATOR_PROVIDER=template

# --- Recommendations provider ---
# mock: deterministic rule-based recommendations (default, no API key required)
# openai: requires OPENAI_API_KEY
RECOMMENDATION_PROVIDER=mock
