# Copy to .env in this directory (gitignored). Used by root docker-compose and backend/docker-compose.

# --- Runtime ---
NODE_ENV=development
PORT=3000
DATABASE_PATH=./data/decisions.db

# --- Storage ---
# sqlite: persistent local database (Docker / dev)
# memory: in-process storage for demo deploys (data lost on restart)
STORAGE_PROVIDER=sqlite

# --- Logging ---
LOG_LEVEL=info

# --- OpenAI ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- Architecture decision generator ---
# template: local markdown generator (default, no API key required)
# openai: requires OPENAI_API_KEY
ARCHITECTURE_DECISION_GENERATOR_PROVIDER=template
