{
  "name": "arch-decisions-backend",
  "version": "1.0.0",
  "description": "Architecture Decisions Platform - Backend",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "npx tsx watch src/index.ts",
    "worker:dev": "npx tsx watch src/worker.ts",
    "worker:prod": "node dist/worker.js",
    "build": "tsc && tsc-alias -p tsconfig.json",
    "start": "node dist/index.js",
    "lint": "eslint . --ext ts --report-unused-disable-directives --max-warnings 0",
    "format": "prettier --write \"src/**/*.{ts,json}\"",
    "test": "jest",
    "migrate": "tsx scripts/run-migrations.ts",
    "migrate:rollback": "tsx scripts/rollback-migrations.ts",
    "verify:providers": "tsx scripts/verify-provider-matrix.ts"
  },
  "dependencies": {
    "awilix": "^13.0.5",
    "better-sqlite3": "^11.3.0",
    "bullmq": "^5.80.4",
    "cors": "^2.8.5",
    "express": "^5.2.1",
    "express-rate-limit": "^8.5.2",
    "helmet": "^8.3.0",
    "ioredis": "^5.11.1",
    "knex": "^3.1.0",
    "openai": "^4.73.0",
    "winston": "^3.11.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.11",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.6",
    "@types/helmet": "^0.0.48",
    "@types/jest": "^29.5.12",
    "@types/node": "^20.14.10",
    "@typescript-eslint/eslint-plugin": "^7.13.1",
    "@typescript-eslint/parser": "^7.13.1",
    "eslint": "^8.57.0",
    "jest": "^29.7.0",
    "prettier": "^3.3.2",
    "ts-jest": "^29.2.5",
    "tsc-alias": "^1.9.1",
    "tsx": "^4.16.2",
    "typescript": "^5.5.3"
  }
}
