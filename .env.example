# Root Compose secrets / shared infra (copy to .env — gitignored).
# Docker Compose loads `.env` in this directory for ${VAR} substitution.

# Redis (Express BullMQ + Python Celery)
REDIS_URL=redis://redis:6379/0

# PostgreSQL (Python backend)
POSTGRES_USER=arch
POSTGRES_PASSWORD=arch
POSTGRES_DB=arch_decisions
