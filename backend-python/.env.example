# Copy to .env in this directory (gitignored).

# --- Runtime ---
APP_ENV=development
PORT=3000
LOG_LEVEL=info

# --- Storage ---
# postgres: persistent PostgreSQL (Docker / dev)
# memory: in-process storage for demos (data lost on restart)
STORAGE_PROVIDER=postgres
# Used for non-Compose local runs. Under Docker Compose, DATABASE_URL is set from
# root `.env` (POSTGRES_USER / POSTGRES_PASSWORD / POSTGRES_DB) and overrides this.
DATABASE_URL=postgresql+psycopg://arch:arch@postgres:5432/arch_decisions

# --- OpenAI ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_TIMEOUT_MS=30000
OPENAI_MAX_RETRIES=2

# --- Queue (Celery) ---
# Under Docker Compose, REDIS_URL comes from root `.env` and overrides this.
REDIS_URL=redis://redis:6379/0
# Workers set SKIP_DB_MIGRATIONS=1 in compose (API owns migrations).

# --- Providers ---
# template | openai
ARCHITECTURE_DECISION_GENERATOR_PROVIDER=template
# mock | openai
RECOMMENDATION_PROVIDER=mock
